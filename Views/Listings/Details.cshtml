@model Property
@{
    ViewData["Title"] = Model.Title;
    var images = Model.Images.ToList();
}

<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-controller="Listings" asp-action="Index">Danh sách</a></li>
    <li class="breadcrumb-item active">@Model.Title</li>
</ol></nav>

<div class="row">
    <div class="col-lg-8">
        <div id="gallery" class="carousel slide mb-3" data-bs-ride="carousel">
            <div class="carousel-inner">
                @if (images.Count == 0)
                {
                    <div class="carousel-item active"><img src="/uploads/placeholder-1.svg" class="d-block w-100" style="height:380px;object-fit:cover" alt="@Model.Title" /></div>
                }
                else
                {
                    for (int i = 0; i < images.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@images[i].ImageUrl" class="d-block w-100" style="height:380px;object-fit:cover" alt="@Model.Title" />
                        </div>
                    }
                }
            </div>
            @if (images.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#gallery" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
                <button class="carousel-control-next" type="button" data-bs-target="#gallery" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
            }
        </div>
        <div class="card shadow-sm mb-3"><div class="card-body">
            <h1 class="h4">@Model.Title</h1>
            <p class="text-primary fs-5 fw-bold">@Model.Price.ToString("N0") đ</p>
            <span class="badge bg-danger">@(Model.IsForRent ? "Cho thuê" : "Bán")</span>
            <p class="mt-3">@Model.Description</p>
        </div></div>
        <div class="card shadow-sm mb-3"><div class="card-body">
            <h2 class="h5"><i class="bi bi-diagram-3"></i> Thông tin bất động sản</h2>
            <div class="row text-center">
                <div class="col"><div class="border rounded py-2"><div class="fw-bold">@Model.Area.ToString("N0") m²</div><small class="text-muted">Diện tích</small></div></div>
                <div class="col"><div class="border rounded py-2"><div class="fw-bold">@Model.Bedrooms PN</div><small class="text-muted">Phòng ngủ</small></div></div>
                <div class="col"><div class="border rounded py-2"><div class="fw-bold">@Model.Bathrooms WC</div><small class="text-muted">Phòng tắm</small></div></div>
                <div class="col"><div class="border rounded py-2"><div class="fw-bold">@Model.Floors tầng</div><small class="text-muted">Số tầng</small></div></div>
                <div class="col"><div class="border rounded py-2"><div class="fw-bold">@Model.FacadeWidth.ToString("N1") m</div><small class="text-muted">Mặt tiền</small></div></div>
            </div>
            <hr />
            <p><i class="bi bi-geo-alt"></i> <strong>@Model.Address</strong></p>
            <p><small class="text-muted">Đăng ngày: @Model.CreatedAt.ToString("dd/MM/yyyy") · Loại: @Model.PropertyType?.Name</small></p>
        </div></div>
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            <div class="card shadow-sm mb-3"><div class="card-body">
                <h2 class="h5"><i class="bi bi-map"></i> Vị trí trên bản đồ</h2>
                <div id="map" style="height:320px" data-lat="@Model.Latitude" data-lng="@Model.Longitude" data-title="@Model.Title"></div>
            </div></div>
        }
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm mb-3"><div class="card-body">
            <h2 class="h5"><i class="bi bi-person"></i> Thông tin liên hệ</h2>
            <p class="mb-1"><strong>@Model.Owner?.FullName</strong></p>
            <p><i class="bi bi-telephone"></i> <a href="tel:@Model.ContactPhone">@Model.ContactPhone</a></p>
            @if (User.Identity!.IsAuthenticated)
            {
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                <form asp-controller="Listings" asp-action="Contact" method="post">
                    <input type="hidden" name="propertyId" value="@Model.Id" />
                    <div class="mb-2"><input type="text" name="name" class="form-control" placeholder="Họ tên" value="@User.Identity.Name" required /></div>
                    <div class="mb-2"><input type="text" name="phone" class="form-control" placeholder="Số điện thoại" required /></div>
                    <div class="mb-2"><textarea name="message" class="form-control" rows="3" placeholder="Nội dung liên hệ..."></textarea></div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-send"></i> Gửi liên hệ</button>
                </form>
            }
            else
            {
                <p class="text-muted">Vui lòng <a asp-controller="Account" asp-action="Login">đăng nhập</a> để liên hệ người bán.</p>
            }
        </div></div>
        <div class="card shadow-sm"><div class="card-body text-center">
            @if (User.IsInRole("Buyer") || User.IsInRole("Seller"))
            {
                <form asp-controller="Favorites" asp-action="Toggle" method="post">
                    <input type="hidden" name="propertyId" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-heart"></i> Lưu tin</button>
                </form>
            }
        </div></div>
    </div>
</div>

@section Scripts {
    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            (function () {
                var el = document.getElementById('map');
                var lat = parseFloat(el.dataset.lat), lng = parseFloat(el.dataset.lng);
                var map = L.map('map').setView([lat, lng], 14);
                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap' }).addTo(map);
                L.marker([lat, lng]).addTo(map).bindPopup(el.dataset.title);
            })();
        </script>
    }
}