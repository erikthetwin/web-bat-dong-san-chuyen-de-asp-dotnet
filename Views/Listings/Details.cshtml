@model Property
@{
    ViewData["Title"] = Model.Title;
    var images = Model.Images.ToList();
}

<nav aria-label="breadcrumb"><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-controller="Listings" asp-action="Index">Danh sách</a></li>
    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
</ol></nav>

<div class="row g-4">
    <div class="col-lg-8">
        <div id="gallery" class="carousel slide mb-4" data-bs-ride="carousel">
            <div class="carousel-inner">
                @if (images.Count == 0)
                {
                    <div class="carousel-item active"><img src="/uploads/placeholder-1.svg" class="d-block w-100" style="height:380px;object-fit:cover" alt="@Model.Title" /></div>
                }
                else
                {
                    for (int i = 0; i < images.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@images[i].ImageUrl" class="d-block w-100" style="height:380px;object-fit:cover" alt="@Model.Title" />
                        </div>
                    }
                }
            </div>
            @if (images.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#gallery" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
                <button class="carousel-control-next" type="button" data-bs-target="#gallery" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
            }
        </div>
        <div class="card shadow-sm mb-4"><div class="card-body">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
                <h1 class="h3 fw-bold mb-0">@Model.Title</h1>
                <span class="badge @(Model.IsForRent ? "badge-rent" : "badge-sale") align-self-center">@(Model.IsForRent ? "Cho thuê" : "Bán")</span>
            </div>
            <p class="price fs-4 mb-3">@Model.Price.ToString("N0") đ</p>
            <p class="mb-0">@Model.Description</p>
        </div></div>
        <div class="card shadow-sm mb-4"><div class="card-body">
            <h2 class="h5 fw-bold mb-3"><i class="bi bi-diagram-3 me-1"></i> Thông tin bất động sản</h2>
            <div class="row g-2">
                <div class="col-6 col-md"><div class="spec-tile"><div class="spec-value">@Model.Area.ToString("N0") m²</div><div class="spec-label">Diện tích</div></div></div>
                <div class="col-6 col-md"><div class="spec-tile"><div class="spec-value">@Model.Bedrooms PN</div><div class="spec-label">Phòng ngủ</div></div></div>
                <div class="col-6 col-md"><div class="spec-tile"><div class="spec-value">@Model.Bathrooms WC</div><div class="spec-label">Phòng tắm</div></div></div>
                <div class="col-6 col-md"><div class="spec-tile"><div class="spec-value">@Model.Floors tầng</div><div class="spec-label">Số tầng</div></div></div>
                <div class="col-6 col-md"><div class="spec-tile"><div class="spec-value">@Model.FacadeWidth.ToString("N1") m</div><div class="spec-label">Mặt tiền</div></div></div>
            </div>
            <hr class="my-4" />
            <p class="mb-1"><i class="bi bi-geo-alt me-1 text-primary"></i> <strong>@Model.Address</strong></p>
            <p class="small text-muted mb-0">Đăng ngày: @Model.CreatedAt.ToString("dd/MM/yyyy") · Loại: @Model.PropertyType?.Name</p>
        </div></div>
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            <div class="card shadow-sm mb-4"><div class="card-body">
                <h2 class="h5 fw-bold mb-3"><i class="bi bi-map me-1"></i> Vị trí trên bản đồ</h2>
                <div id="map" style="height:320px" data-lat="@Model.Latitude" data-lng="@Model.Longitude" data-title="@Model.Title"></div>
            </div></div>
        }
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4 card-hover"><div class="card-body">
            <h2 class="h5 fw-bold mb-3"><i class="bi bi-person me-1"></i> Thông tin liên hệ</h2>
            <p class="mb-1 fw-semibold fs-6">@Model.Owner?.FullName</p>
            <p class="mb-3"><i class="bi bi-telephone me-1 text-primary"></i> <a href="tel:@Model.ContactPhone" class="fw-semibold">@Model.ContactPhone</a></p>
            @if (User.Identity!.IsAuthenticated)
            {
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                <form asp-controller="Listings" asp-action="Contact" method="post">
                    <input type="hidden" name="propertyId" value="@Model.Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <div class="mb-2"><input type="text" name="name" class="form-control" placeholder="Họ tên" value="@User.Identity.Name" required /></div>
                    <div class="mb-2"><input type="text" name="phone" class="form-control" placeholder="Số điện thoại" required /></div>
                    <div class="mb-3"><textarea name="message" class="form-control" rows="3" placeholder="Nội dung liên hệ..."></textarea></div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-send me-1"></i> Gửi liên hệ</button>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">Vui lòng <a asp-controller="Account" asp-action="Login">đăng nhập</a> để liên hệ người bán.</p>
            }
        </div></div>
        @if (User.IsInRole("Buyer") || User.IsInRole("Seller"))
        {
            <div class="card shadow-sm"><div class="card-body text-center">
                <form asp-controller="Favorites" asp-action="Toggle" method="post">
                    <input type="hidden" name="propertyId" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-heart me-1"></i> Lưu tin</button>
                </form>
            </div></div>
        }
    </div>
</div>

@section Scripts {
    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    }
}