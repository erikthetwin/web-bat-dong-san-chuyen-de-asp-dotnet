@model SearchResult
@{
    ViewData["Title"] = "Danh sách bất động sản";
    var f = (PropertyFilter?)ViewBag.Filter ?? new PropertyFilter();
    var types = (List<PropertyType>?)ViewBag.Types ?? new();
    var districts = (List<string>?)ViewBag.Districts ?? new();
}

<div class="row">
    <div class="col-md-3">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-funnel"></i> Bộ lọc</h5>
                <form asp-controller="Listings" asp-action="Index" method="get">
                    <div class="mb-2"><input type="text" name="keyword" class="form-control" placeholder="Từ khóa" value="@f.Keyword" /></div>
                    <div class="mb-2">
                        <select name="district" class="form-select">
                            <option value="">Tất cả quận/huyện</option>
                            @foreach (var d in districts)
                            {
                                <option value="@d" selected="@(f.District == d)">@d</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <select name="propertyTypeId" class="form-select">
                            <option value="">Tất cả loại hình</option>
                            @foreach (var t in types)
                            {
                                <option value="@t.Id" selected="@(f.PropertyTypeId == t.Id)">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="row g-1 mb-2">
                        <div class="col-6"><input type="number" name="minPrice" class="form-control" placeholder="Giá từ" value="@f.MinPrice" /></div>
                        <div class="col-6"><input type="number" name="maxPrice" class="form-control" placeholder="Đến" value="@f.MaxPrice" /></div>
                    </div>
                    <div class="row g-1 mb-2">
                        <div class="col-6"><input type="number" name="minArea" class="form-control" placeholder="Diện tích từ" value="@f.MinArea" /></div>
                        <div class="col-6"><input type="number" name="maxArea" class="form-control" placeholder="Đến" value="@f.MaxArea" /></div>
                    </div>
                    <div class="mb-2">
                        <select name="bedrooms" class="form-select">
                            <option value="">Số phòng ngủ</option>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <option value="@i" selected="@(f.Bedrooms == i)">@i PN+</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <select name="isForRent" class="form-select">
                            <option value="">Mua / Thuê</option>
                            <option value="false" selected="@(f.IsForRent == false)">Mua</option>
                            <option value="true" selected="@(f.IsForRent == true)">Thuê</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <select name="sort" class="form-select">
                            <option value="newest" selected="@(f.Sort == "newest")">Mới nhất</option>
                            <option value="price_asc" selected="@(f.Sort == "price_asc")">Giá tăng dần</option>
                            <option value="price_desc" selected="@(f.Sort == "price_desc")">Giá giảm dần</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Lọc</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <p class="text-muted">Tìm thấy <strong>@Model.TotalCount</strong> bất động sản</p>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var p in Model.Items)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@(p.Images.FirstOrDefault()?.ImageUrl ?? "/uploads/placeholder-1.svg")" class="card-img-top" style="height:170px;object-fit:cover" alt="@p.Title" />
                        <div class="card-body">
                            <span class="badge bg-danger mb-2">@(p.IsForRent ? "Cho thuê" : "Bán")</span>
                            <h6 class="card-title"><a asp-controller="Listings" asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">@p.Title</a></h6>
                            <p class="text-primary fw-bold mb-1">@p.Price.ToString("N0") đ</p>
                            <p class="text-muted small mb-1"><i class="bi bi-geo-alt"></i> @p.District</p>
                            <p class="text-muted small mb-0">@p.Area.ToString("N0") m² · @p.Bedrooms PN · @p.Bathrooms WC</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4"><ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    var qs = new Dictionary<string, string?>
                    {
                        ["keyword"] = f.Keyword, ["district"] = f.District,
                        ["propertyTypeId"] = f.PropertyTypeId?.ToString(), ["minPrice"] = f.MinPrice?.ToString(),
                        ["maxPrice"] = f.MaxPrice?.ToString(), ["minArea"] = f.MinArea?.ToString(),
                        ["maxArea"] = f.MaxArea?.ToString(), ["bedrooms"] = f.Bedrooms?.ToString(),
                        ["isForRent"] = f.IsForRent?.ToString(), ["sort"] = f.Sort, ["page"] = i.ToString()
                    };
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-controller="Listings" asp-action="Index" asp-all-route-data="qs">@i</a>
                    </li>
                }
            </ul></nav>
        }
    </div>
</div>