@model List<Property>
@{ ViewData["Title"] = "Tin đã lưu"; }
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<h1 class="h4 mb-3">Tin đã lưu (@Model.Count)</h1>
@if (Model.Count == 0)
{
    <p class="text-muted">Bạn chưa lưu tin nào.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@(p.Images.FirstOrDefault()?.ImageUrl ?? "/uploads/placeholder-1.svg")" class="card-img-top" style="height:170px;object-fit:cover" alt="@p.Title" />
                    <div class="card-body">
                        <h6 class="card-title"><a asp-controller="Listings" asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">@p.Title</a></h6>
                        <p class="text-primary fw-bold mb-1">@p.Price.ToString("N0") đ</p>
                        <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> @p.District</p>
                        <form asp-controller="Favorites" asp-action="Toggle" method="post">
                            <input type="hidden" name="propertyId" value="@p.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-heartbreak"></i> Bỏ lưu</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}