@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="row justify-content-center py-4"><div class="col-md-5 col-lg-4">
    <div class="card shadow-lg border-0">
        <div class="card-header border-0 text-white text-center py-3" style="background: linear-gradient(135deg, #0F766E, #0369A1); border-radius: 1rem 1rem 0 0;">
            <i class="bi bi-box-arrow-in-right fs-3"></i>
            <h1 class="h4 fw-bold mt-1 mb-0">Đăng nhập</h1>
        </div>
        <div class="card-body p-4">
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger small"></div>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /></div>
                <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /></div>
                <div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div>
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập</button>
            </form>
            <p class="mt-4 mb-0 text-center"><a asp-action="Register">Chưa có tài khoản? <strong>Đăng ký</strong></a></p>
        </div>
    </div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }