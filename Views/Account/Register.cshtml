@model RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; }
<div class="row justify-content-center py-4"><div class="col-md-6 col-lg-5">
    <div class="card shadow-lg border-0">
        <div class="card-header border-0 text-white text-center py-3" style="background: linear-gradient(135deg, #0F766E, #0369A1); border-radius: 1rem 1rem 0 0;">
            <i class="bi bi-person-plus fs-3"></i>
            <h1 class="h4 fw-bold mt-1 mb-0">Tạo tài khoản</h1>
        </div>
        <div class="card-body p-4">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="All" class="text-danger small"></div>
                <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" /></div>
                <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /></div>
                <div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" /></div>
                <div class="mb-3"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" autocomplete="street-address" /></div>
                <div class="row g-2 mb-3">
                    <div class="col-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /></div>
                    <div class="col-6"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
                </div>
                <div class="mb-4">
                    <label asp-for="Role" class="form-label"></label>
                    <select asp-for="Role" class="form-select">
                        <option value="Buyer">Người mua</option>
                        <option value="Seller">Người bán</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-person-plus me-1"></i> Đăng ký</button>
            </form>
            <p class="mt-4 mb-0 text-center"><a asp-action="Login">Đã có tài khoản? <strong>Đăng nhập</strong></a></p>
        </div>
    </div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }