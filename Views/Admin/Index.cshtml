@model AdminStats
@{
    ViewData["Title"] = "Trang quản trị";
    var statusCards = new (string Label, string Badge, int Value)[]
    {
        ("Tổng tin", "bg-primary", Model.TotalListings),
        ("Chờ duyệt", "bg-warning text-dark", Model.Pending),
        ("Đã duyệt", "bg-success", Model.Approved),
        ("Từ chối", "bg-danger", Model.Rejected),
        ("Bị khóa", "bg-dark", Model.Banned),
        ("Đã bán", "bg-secondary", Model.Sold),
        ("Người dùng", "bg-info", Model.TotalUsers),
        ("Liên hệ", "bg-secondary", Model.TotalContacts)
    };
}
<h1 class="h4 mb-3">Trang quản trị</h1>
<div class="row g-3 mb-4">
    @foreach (var c in statusCards)
    {
        <div class="col-md-3"><div class="card text-white @c.Badge shadow-sm"><div class="card-body text-center">
            <div class="fs-3 fw-bold">@c.Value</div><div>@c.Label</div>
        </div></div></div>
    }
</div>
<div class="row">
    <div class="col-md-6"><div class="card shadow-sm"><div class="card-body">
        <h2 class="h6">Số tin theo loại hình</h2>
        <table class="table table-sm">
            <thead><tr><th>Loại</th><th class="text-end">Số tin</th></tr></thead>
            <tbody>
            @foreach (var (type, count) in Model.ByType)
            {
                <tr><td>@type</td><td class="text-end">@count</td></tr>
            }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-md-6"><div class="card shadow-sm"><div class="card-body">
        <h2 class="h6">Số tin theo quận/huyện</h2>
        <table class="table table-sm">
            <thead><tr><th>Quận</th><th class="text-end">Số tin</th></tr></thead>
            <tbody>
            @foreach (var (district, count) in Model.ByDistrict)
            {
                <tr><td>@district</td><td class="text-end">@count</td></tr>
            }
            </tbody>
        </table>
    </div></div></div>
</div>
<div class="mt-3">
    <a asp-action="Moderation" class="btn btn-primary">Duyệt tin</a>
    <a asp-action="Users" class="btn btn-outline-primary">Quản lý người dùng</a>
    <a asp-action="Types" class="btn btn-outline-primary">Loại bất động sản</a>
</div>