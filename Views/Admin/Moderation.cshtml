@model List<Property>
@{ ViewData["Title"] = "Duyệt tin"; }
<h1 class="h3 fw-bold mb-4"><i class="bi bi-clipboard2-check me-2 text-primary"></i>Duyệt tin (@Model.Count)</h1>
@if (Model.Count == 0)
{
    <div class="card p-5 text-center text-muted">
        <i class="bi bi-check2-all display-4 mb-3 text-success"></i>
        <p class="mb-0">Không có tin cần duyệt.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-6">
                <div class="card shadow-sm h-100 card-hover"><div class="card-body">
                    <div class="d-flex gap-3">
                        <img src="@(p.Images.FirstOrDefault()?.ImageUrl ?? "/uploads/placeholder-1.svg")" style="width:120px;height:90px;object-fit:cover" class="rounded" alt="" />
                        <div class="flex-grow-1">
                            <h2 class="h6 fw-bold">@p.Title</h2>
                            <p class="small text-muted mb-1">@p.Address · @p.Area m² · @p.Price.ToString("N0") đ</p>
                            <p class="small mb-1"><strong>@p.Owner?.FullName</strong> (@p.Owner?.Email) · @p.Owner?.PhoneNumber</p>
                            <p class="small text-muted mb-2">Loại: @p.PropertyType?.Name · Đăng: @p.CreatedAt.ToString("dd/MM/yyyy") · Trạng thái: @p.Status</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <form asp-action="Approve" method="post"><input type="hidden" name="id" value="@p.Id" /><button class="btn btn-sm btn-success"><i class="bi bi-check-lg me-1"></i>Duyệt</button></form>
                                <form asp-action="Reject" method="post"><input type="hidden" name="id" value="@p.Id" /><button class="btn btn-sm btn-danger"><i class="bi bi-x-lg me-1"></i>Từ chối</button></form>
                                <form asp-action="Ban" method="post"><input type="hidden" name="id" value="@p.Id" /><button class="btn btn-sm btn-dark"><i class="bi bi-lock me-1"></i>Khóa</button></form>
                            </div>
                        </div>
                    </div>
                </div></div>
            </div>
        }
    </div>
}