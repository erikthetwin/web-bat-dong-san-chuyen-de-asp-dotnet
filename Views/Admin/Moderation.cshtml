@model List<Property>
@{ ViewData["Title"] = "Duyệt tin"; }
<h1 class="h4 mb-3">Duyệt tin (@Model.Count)</h1>
@if (Model.Count == 0)
{
    <p class="text-muted">Không có tin cần duyệt.</p>
}
else
{
    <div class="row g-3">
        @foreach (var p in Model)
        {
            <div class="col-md-6">
                <div class="card shadow-sm h-100"><div class="card-body">
                    <div class="d-flex gap-3">
                        <img src="@(p.Images.FirstOrDefault()?.ImageUrl ?? "/uploads/placeholder-1.svg")" style="width:120px;height:90px;object-fit:cover" class="rounded" alt="" />
                        <div>
                            <h2 class="h6">@p.Title</h2>
                            <p class="small text-muted mb-1">@p.Address · @p.Area m² · @p.Price.ToString("N0") đ</p>
                            <p class="small mb-1"><strong>@p.Owner?.FullName</strong> (@p.Owner?.Email) · @p.Owner?.PhoneNumber</p>
                            <p class="small text-muted mb-2">Loại: @p.PropertyType?.Name · Đăng: @p.CreatedAt.ToString("dd/MM/yyyy") · Trạng thái: @p.Status</p>
                            <div class="d-flex gap-2">
                                <form asp-action="Approve" method="post"><input type="hidden" name="id" value="@p.Id" /><button class="btn btn-sm btn-success">Duyệt</button></form>
                                <form asp-action="Reject" method="post"><input type="hidden" name="id" value="@p.Id" /><button class="btn btn-sm btn-danger">Từ chối</button></form>
                                <form asp-action="Ban" method="post"><input type="hidden" name="id" value="@p.Id" /><button class="btn btn-sm btn-dark">Khóa</button></form>
                            </div>
                        </div>
                    </div>
                </div></div>
            </div>
        }
    </div>
}