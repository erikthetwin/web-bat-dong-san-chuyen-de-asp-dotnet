@model List<Property>
@{
    ViewData["Title"] = "Trang chủ";
    var types = (List<PropertyType>?)ViewBag.Types ?? new();
    var districts = (List<string>?)ViewBag.Districts ?? new();
}

<section class="hero-panel p-4 p-md-5 mb-5">
    <h1 class="display-5 fw-bold">VNEstates · Tìm bất động sản phù hợp với bạn</h1>
    <p class="lead mb-4">Mua, bán, cho thuê nhà đất tại TP.HCM</p>
    <form asp-controller="Listings" asp-action="Index" method="get" class="row g-2 hero-search p-3 p-md-4 rounded-4">
        <div class="col-md-4">
            <label class="form-label text-white small fw-semibold" for="keyword">Từ khóa</label>
            <input type="text" id="keyword" name="keyword" class="form-control" placeholder="Tên, địa chỉ..." />
        </div>
        <div class="col-md-3">
            <label class="form-label text-white small fw-semibold" for="district">Quận/Huyện</label>
            <select id="district" name="district" class="form-select">
                <option value="">Tất cả quận/huyện</option>
                @foreach (var d in districts)
                {
                    <option value="@d">@d</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label text-white small fw-semibold" for="propertyTypeId">Loại hình</label>
            <select id="propertyTypeId" name="propertyTypeId" class="form-select">
                <option value="">Tất cả loại hình</option>
                @foreach (var t in types)
                {
                    <option value="@t.Id">@t.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-warning w-100 fw-semibold"><i class="bi bi-search me-1"></i> Tìm</button>
        </div>
    </form>
</section>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="h3 mb-0 fw-bold">Bất động sản mới nhất</h2>
    <a asp-controller="Listings" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">Xem tất cả <i class="bi bi-arrow-right ms-1"></i></a>
</div>
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="card property-card h-100 card-hover">
                <div class="position-relative">
                    <img src="@(p.Images.FirstOrDefault()?.ImageUrl ?? "/uploads/placeholder-1.svg")" class="card-img-top" style="height:200px;object-fit:cover" alt="@p.Title" />
                    <span class="badge @(p.IsForRent ? "badge-rent" : "badge-sale") position-absolute top-0 start-0 m-2">@(p.IsForRent ? "Cho thuê" : "Bán")</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title"><a asp-controller="Listings" asp-action="Details" asp-route-id="@p.Id">@p.Title</a></h5>
                    <p class="price mb-1">@p.Price.ToString("N0") đ</p>
                    <p class="text-muted small mb-1"><i class="bi bi-geo-alt"></i> @p.District</p>
                    <p class="text-muted small mb-0"><i class="bi bi-rulers"></i> @p.Area.ToString("N0") m² · <i class="bi bi-door-open"></i> @p.Bedrooms PN · <i class="bi bi-droplet"></i> @p.Bathrooms WC</p>
                </div>
            </div>
        </div>
    }
</div>